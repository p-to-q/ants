# Daily verified backup of every ledger in a series.  Instance = series name.
# Triggered by ants-series-backup@.timer.
[Unit]
Description=ants series backup (%i)

[Service]
Type=oneshot
User=ants
Group=ants
WorkingDirectory=/opt/ants
ExecStart=/opt/ants/deploy/series_backup.sh %i

# --- sandboxing: same directives as ants@.service ---
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/ants
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0077
