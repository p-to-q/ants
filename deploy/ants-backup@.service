[Unit]
Description=ants ledger backup (%i): verified online snapshot

[Service]
Type=oneshot
User=ants
Group=ants
WorkingDirectory=/opt/ants
ExecStart=/opt/ants/.venv/bin/ants backup --workdir /var/lib/ants/%i --dest /var/lib/ants/backups/%i --keep 14 --gzip
Nice=10
IOSchedulingClass=idle
CPUQuota=50%
MemoryMax=400M
TasksMax=64

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/ants
InaccessiblePaths=/etc/ants
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0077
