[Unit]
Description=ants health check (%i): ants doctor, fails the unit when the lab is unhealthy

[Service]
Type=oneshot
User=ants
Group=ants
WorkingDirectory=/opt/ants
Environment=ANTS_BACKUP_DIR=/var/lib/ants/backups/%i
ExecStart=/opt/ants/.venv/bin/ants doctor --contract /opt/ants/contracts/tinyts.toml --workdir /var/lib/ants/%i --arm %i
CPUQuota=25%
MemoryMax=200M
TasksMax=64

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/ants
InaccessiblePaths=/etc/ants
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0077
